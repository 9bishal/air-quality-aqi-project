# ── Airflow ──
airflow/logs/
airflow/*.db
airflow/*.sqlite3
airflow/airflow.cfg
airflow/webserver_config.py
airflow/standalone_admin_password.txt
celerybeat-schedule
celerybeat.pid
airflow.db

# ── Data Pipeline Artifacts (regenerated by ETL) ──
# Ignore everything under data/ but keep directory structure via .gitkeep
data/raw/**
!data/raw/.gitkeep
!data/raw/openaq/
!data/raw/openaq/.gitkeep
!data/raw/openmeteo/
!data/raw/openmeteo/.gitkeep
data/staging/**
!data/staging/.gitkeep
data/cleaned/**
!data/cleaned/.gitkeep
data/gold/**
!data/gold/.gitkeep
data/rejected/**
!data/rejected/.gitkeep

# ── Logs ──
logs/**
*.log
!logs/.gitkeep

# ── Archives (don't push large zips) ──
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz

# ── Env Managers ──
.python-version
.tool-versions
uv.lock
poetry.lock
Pipfile.lock
.conda/

# ── OS ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
